# TMDB v4 Read Access Token (Bearer). Used by the app to fetch film metadata/posters.
# Copy this file to `.env` and paste your real token. `.env` is git-ignored.
TMDB_READ_TOKEN=YOUR_TMDB_V4_READ_ACCESS_TOKEN

# Base URL of the deployed /recommend Cloud Run service (e.g. https://recommender-xxxx.run.app).
# Leave empty until the backend is deployed — the app falls back to TMDB feeds when unset.
RECOMMENDER_BASE_URL=
