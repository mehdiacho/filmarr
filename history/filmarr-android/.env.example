# TMDB v4 Read Access Token (Bearer). Used by the app to fetch film metadata/posters.
# Copy this file to `.env` and paste your real token. `.env` is git-ignored.
TMDB_READ_TOKEN=YOUR_TMDB_V4_READ_ACCESS_TOKEN

# Base URL of the deployed /recommend Cloud Run service. Must be non-empty (the Secrets
# Gradle plugin emits invalid Java for a blank value). The app still falls back to TMDB at
# runtime if the backend errors or returns no recs.
RECOMMENDER_BASE_URL=https://recommender-jble43nkma-ew.a.run.app
