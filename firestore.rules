rules_version = '2';

// Security model:
//   - A user may read/write ONLY their own document subtree (users/{uid}/...).
//   - `movies` is public read, no client writes (populated server-side from TMDB).
//   - `edges`, `graph_snapshots`, and `recs` are NEVER client-writable and (except
//     recs, which the owner may read) not client-readable — they're touched only by
//     the Cloud Run service / batch jobs via the Admin SDK, which bypasses these rules.
//   - The interaction log is append-only: create allowed, update/delete denied, so the
//     temporal model always has a clean history (GRAPH_RECOMMENDER.md §11).

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ---- User subtree ----------------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid);
      // Never let a client write server-managed fields.
      allow create, update: if isOwner(uid)
        && !request.resource.data.keys().hasAny(['is_admin', 'entitlements']);
      allow delete: if false; // account deletion goes through a server flow

      // Library entries: owner CRUD.
      match /library/{movieId} {
        allow read, write: if isOwner(uid);
      }

      // Interaction log: APPEND-ONLY. This is the training substrate; never mutate.
      match /interactions/{eventId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.ts is timestamp
          && request.resource.data.movie_id is int;
        allow update, delete: if false;
      }

      // Hidden "hearted" list (double-tap). Owner-only; system reads it server-side.
      match /hearted/{movieId} {
        allow read, write: if isOwner(uid);
      }

      // Any other per-user subcollection defaults to owner-only.
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---- Public catalog (read-only to clients) ---------------------------
    match /movies/{movieId} {
      allow read: if request.auth != null;
      allow write: if false; // server-side only
    }

    // ---- Served recommendation cache (owner may read, never write) -------
    match /recs/{uid} {
      allow read: if isOwner(uid);
      allow write: if false; // written by the Cloud Run service
      match /{document=**} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ---- Graph internals: fully server-only ------------------------------
    match /edges/{edgeId} {
      allow read, write: if false;
    }
    match /graph_snapshots/{snapId} {
      allow read, write: if false;
    }

    // Deny everything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
